<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0E20"
    android:orientation="vertical">

    <!-- HEADER AREA (Premium cinematic header with floating circular back button) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#0C0E20"
        android:paddingTop="20dp">

        <ImageView
            android:id="@+id/viewerClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"
            android:background="@drawable/ic_back_container_bg"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_white"
            android:contentDescription="Close viewer"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Images &amp; Videos"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/viewerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="Client ID: ----"
                android:textColor="#A0A5C0"
                android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- MEDIA PREVIEW CONTAINER (CardView layout with premium background) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#151833"
            app:cardMaxElevation="12dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- IMAGE VIEW -->
                <ImageView
                    android:id="@+id/viewerImageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="Image preview"
                    android:visibility="gone" />

                <!-- VIDEO VIEW -->
                <VideoView
                    android:id="@+id/viewerVideoView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <!-- LOADING SPINNER -->
                <ProgressBar
                    android:id="@+id/viewerProgressBar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/ios_loading_progress" />

                <!-- VIDEO CONTROLLER OVERLAY (Custom UI) -->
                <RelativeLayout
                    android:id="@+id/videoControlsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#26000000"
                    android:visibility="gone">

                    <!-- Floating Play/Pause Button in the Center with elevation and press effect -->
                    <ImageView
                        android:id="@+id/btnPlayPause"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/play_circle_bg"
                        android:padding="16dp"
                        android:src="@drawable/ic_play"
                        app:tint="#FFFFFF"
                        android:elevation="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Custom Bottom Seekbar and Time Display (translucent glassmorphic) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_margin="16dp"
                        android:background="@drawable/bg_glass_controls"
                        android:padding="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:elevation="4dp">

                        <TextView
                            android:id="@+id/tvCurrentTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="00:00"
                            android:textColor="@color/white"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/videoSeekBar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="0"
                            android:thumbTint="#FFFFFF"
                            android:progressTint="#4F46E5"
                            android:progressBackgroundTint="#4DFFFFFF" />

                        <TextView
                            android:id="@+id/tvTotalDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="00:00"
                            android:textColor="@color/white"
                            android:textSize="12sp" />
                    </LinearLayout>
                </RelativeLayout>

            </FrameLayout>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>

    <!-- ACTION BUTTONS AREA (Gradient & glass custom pill buttons) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp"
        android:gravity="center">

        <TextView
            android:id="@+id/viewerShare"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:background="@drawable/btn_share_premium_bg"
            android:gravity="center"
            android:fontFamily="@font/poppins_bold"
            android:text="Share"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/viewerDownload"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_download_premium_bg"
            android:gravity="center"
            android:fontFamily="@font/poppins_bold"
            android:text="Download"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
