<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_duration="1000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- First line: Spinner loader -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5sp">

            <View
                android:layout_width="140dp"
                android:layout_height="30dp"
                android:layout_alignParentStart="true"
                android:background="@drawable/shimmer_placeholder_bg" />

            <View
                android:layout_width="150dp"
                android:layout_height="35dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/shimmer_placeholder_bg" />

        </RelativeLayout>

        <!-- Initial Observations header -->
        <View
            android:layout_width="220dp"
            android:layout_height="22dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/shimmer_placeholder_bg" />

        <!-- Freq. Rate block -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20sp">

            <View
                android:layout_width="match_parent"
                android:layout_height="60sp"
                android:background="@drawable/rectangle_check_box_big" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8sp">

                <View
                    android:layout_width="120dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/shimmer_placeholder_bg" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginStart="30sp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/shimmer_placeholder_bg" />

            </LinearLayout>
        </RelativeLayout>

        <!-- Start CMD block -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20sp">

            <View
                android:layout_width="match_parent"
                android:layout_height="150sp"
                android:background="@drawable/rectangle_check_box_big" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8sp">

                <View
                    android:layout_width="120dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/shimmer_placeholder_bg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="19sp"
                    android:orientation="vertical">

                    <View
                        android:layout_width="100dp"
                        android:layout_height="28dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/shimmer_placeholder_bg" />

                    <View
                        android:layout_width="100dp"
                        android:layout_height="28dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/shimmer_placeholder_bg" />

                    <View
                        android:layout_width="100dp"
                        android:layout_height="28dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/shimmer_placeholder_bg" />

                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Input Supply title and options row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="130dp"
                android:layout_height="24dp"
                android:background="@drawable/shimmer_placeholder_bg" />

            <View
                android:layout_width="80dp"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/shimmer_placeholder_bg" />

            <View
                android:layout_width="80dp"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/shimmer_placeholder_bg" />

        </LinearLayout>

        <!-- Input POS/NEG Checkboxes Block -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="90sp"
                android:background="@drawable/rectangle_checkbox" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="5dp">

                <!-- POS Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10sp"
                    android:layout_marginEnd="10sp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="60dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/shimmer_placeholder_bg" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp">

                        <View
                            android:layout_width="50dp"
                            android:layout_height="30dp"
                            android:layout_alignParentStart="true"
                            android:background="@drawable/shimmer_placeholder_bg" />

                        <View
                            android:layout_width="50dp"
                            android:layout_height="30dp"
                            android:layout_centerHorizontal="true"
                            android:background="@drawable/shimmer_placeholder_bg" />

                        <View
                            android:layout_width="50dp"
                            android:layout_height="30dp"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/shimmer_placeholder_bg" />

                    </RelativeLayout>
                </LinearLayout>

                <!-- NEG Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="10sp"
                    android:layout_marginEnd="10sp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="60dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/shimmer_placeholder_bg" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp">

                        <View
                            android:layout_width="50dp"
                            android:layout_height="30dp"
                            android:layout_alignParentStart="true"
                            android:background="@drawable/shimmer_placeholder_bg" />

                        <View
                            android:layout_width="50dp"
                            android:layout_height="30dp"
                            android:layout_centerHorizontal="true"
                            android:background="@drawable/shimmer_placeholder_bg" />

                        <View
                            android:layout_width="50dp"
                            android:layout_height="30dp"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/shimmer_placeholder_bg" />

                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Output Supply title and option row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="140dp"
                android:layout_height="24dp"
                android:background="@drawable/shimmer_placeholder_bg" />

            <View
                android:layout_width="80dp"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/shimmer_placeholder_bg" />

        </LinearLayout>

        <!-- Output POS/NEG Checkboxes Block -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="90sp"
                android:background="@drawable/rectangle_checkbox" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="5dp">

                <!-- POS Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10sp"
                    android:layout_marginEnd="10sp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="60dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/shimmer_placeholder_bg" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp">

                        <View
                            android:layout_width="50dp"
                            android:layout_height="30dp"
                            android:layout_alignParentStart="true"
                            android:background="@drawable/shimmer_placeholder_bg" />

                        <View
                            android:layout_width="50dp"
                            android:layout_height="30dp"
                            android:layout_centerHorizontal="true"
                            android:background="@drawable/shimmer_placeholder_bg" />

                        <View
                            android:layout_width="50dp"
                            android:layout_height="30dp"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/shimmer_placeholder_bg" />

                    </RelativeLayout>
                </LinearLayout>

                <!-- NEG Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="10sp"
                    android:layout_marginEnd="10sp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="60dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/shimmer_placeholder_bg" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp">

                        <View
                            android:layout_width="50dp"
                            android:layout_height="30dp"
                            android:layout_alignParentStart="true"
                            android:background="@drawable/shimmer_placeholder_bg" />

                        <View
                            android:layout_width="50dp"
                            android:layout_height="30dp"
                            android:layout_centerHorizontal="true"
                            android:background="@drawable/shimmer_placeholder_bg" />

                        <View
                            android:layout_width="50dp"
                            android:layout_height="30dp"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/shimmer_placeholder_bg" />

                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Fault Diagnosis header -->
        <View
            android:layout_width="260dp"
            android:layout_height="22dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/shimmer_placeholder_bg" />

        <!-- Observations inputs block -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20sp">

            <View
                android:layout_width="match_parent"
                android:layout_height="150sp"
                android:background="@drawable/rectangle_check_box_big" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8sp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <View
                        android:layout_width="110dp"
                        android:layout_height="20dp"
                        android:layout_margin="10sp"
                        android:background="@drawable/shimmer_placeholder_bg" />

                    <View
                        android:layout_width="110dp"
                        android:layout_height="20dp"
                        android:layout_margin="10sp"
                        android:background="@drawable/shimmer_placeholder_bg" />

                    <View
                        android:layout_width="110dp"
                        android:layout_height="20dp"
                        android:layout_margin="10sp"
                        android:background="@drawable/shimmer_placeholder_bg" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_margin="4sp"
                        android:background="@drawable/shimmer_placeholder_bg" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_margin="4sp"
                        android:background="@drawable/shimmer_placeholder_bg" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_margin="4sp"
                        android:background="@drawable/shimmer_placeholder_bg" />

                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
